OPENROUTER_API_KEY=

# OpenRouter audio model IDs can change. Pick models from your OpenRouter account.
OPENROUTER_STT_MODEL=openai/gpt-4o-transcribe
OPENROUTER_STT_LANGUAGE=
OPENROUTER_TTS_MODEL=openai/gpt-4o-mini-tts-2025-12-15
OPENROUTER_TTS_VOICE=nova
OPENROUTER_TTS_SPEED=1.1

# Optional Codex overrides. If omitted, Codex uses your local config/auth.
CODEX_MODEL=gpt-5.5
CODEX_REASONING_EFFORT=xhigh
CODEX_ENABLE_SEARCH=true
CODEX_WORKDIR=

# Keep the default host local-only. Remote listening is intentionally blocked.
HOST=127.0.0.1
PORT=8787
